# cf-kind-demo — defaults. Do not edit: `make configure` writes local values to config.env.
# Values without quote special characters; environment variables override both files.

# Kubernetes base: docker-desktop | kind | k3d (chapter 4)
K8S_PROVIDER="docker-desktop"

# TLS: selfsigned | letsencrypt (chapter 9). Without DOMAIN, 127-0-0-1.nip.io applies (upstream scheme).
TLS_MODE="selfsigned"
DNS_ZONE="cfapps.cool"
DOMAIN=""
# split: sys.<DOMAIN> + app.<DOMAIN> | flat: <DOMAIN> for system and apps
DOMAIN_LAYOUT="split"
SYS_SUBDOMAIN="sys"
APP_SUBDOMAIN="app"

# Let's Encrypt (TLS_MODE=letsencrypt only)
ACME_DNS_PROVIDER="gcloud"
ACME_DNS_CREDENTIALS="keychain:cf-kind-demo-gcp-dns"
ACME_EMAIL=""
ACME_ENV="staging"
GCP_PROJECT=""

# Optional CF components (credhub, loggregator, nfs, routing-api …); false = leaner, less RAM
CF_OPTIONAL_COMPONENTS="true"

# Docker network "kind" (provider kind): a rarely used subnet avoids clashes with hotel/customer Wi-Fi ranges
KIND_SUBNET="10.213.0.0/16"

# Airgap: true = download nothing from the internet (chapter 6)
AIRGAP="false"
