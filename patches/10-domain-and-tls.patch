diff --git a/scripts/init.sh b/scripts/init.sh
index b5cf010..b287ca5 100755
--- a/scripts/init.sh
+++ b/scripts/init.sh
@@ -4,7 +4,18 @@ set -euo pipefail
 
 mkdir -p temp/certs
 
-OPENSSL="docker run --rm -v $(pwd)/temp/certs:/certs -v $(pwd)/certs/all-in-one.conf:/all-in-one.conf alpine/openssl"
+# cf-kind-demo (patches/10-domain-and-tls.patch): add the demo domain SANs from CF_CERT_EXTRA_SANS, because gorouter
+# verifies backends against the route host (e.g. api.<system domain>) and they serve this certificate.
+cp certs/all-in-one.conf temp/all-in-one.conf
+san_index=100
+set -f
+for san in ${CF_CERT_EXTRA_SANS:-}; do
+	printf 'DNS.%s = %s\n' "$san_index" "$san" >> temp/all-in-one.conf
+	san_index=$((san_index + 1))
+done
+set +f
+
+OPENSSL="docker run --rm -v $(pwd)/temp/certs:/certs -v $(pwd)/temp/all-in-one.conf:/all-in-one.conf alpine/openssl"
 SSH_KEYGEN="docker run --rm -v $(pwd)/temp/certs:/certs --entrypoint /usr/bin/ssh-keygen linuxserver/openssh-server"
 
 $OPENSSL genrsa -traditional -out /certs/ca.key 4096
